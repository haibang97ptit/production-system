# ==============================================================================
# APP
# ==============================================================================
# Dev: development | Prod: production
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# Cron cho worker sync — mặc định mỗi 20 phút
SYNC_CRON=*/20 * * * *

# Chạy sync ngay lúc startup (dev/test = true, prod = false)
SYNC_ON_STARTUP=true

# Số file parse SONG SONG cùng lúc — 5-10 là hợp lý, 20+ nếu server mạnh
SYNC_CONCURRENCY=5

# ==============================================================================
# DATABASE
# ==============================================================================
POSTGRES_USER=batchuser
POSTGRES_PASSWORD=batchpass_CHANGE_IN_PROD
POSTGRES_DB=batch_reports

# ==============================================================================
# SECURITY (production must set)
# ==============================================================================
# API key — client phải gửi header "x-api-key: <value>" mọi request /api/*
# Để rỗng = tắt authentication (chỉ nên dùng dev/internal LAN)
API_KEY=

# CORS: comma-separated origins, VD: "https://mes.example.com,https://app.example.com"
# "*" = cho phép tất cả (không nên dùng prod)
CORS_ORIGINS=*

# Rate limit: max requests / IP trong X phút
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=15

# ==============================================================================
# DEV - Windows local (map ổ mạng thành ổ đĩa)
# ==============================================================================
# VD Windows: C:\BatchReports, Z:\BatchReports, S:\Public\Batch report
REPORT_HOST_DIR=C:\BatchReports

# ==============================================================================
# PROD/DEV-NAS - CIFS mount trực tiếp trong Docker
# ==============================================================================
NAS_HOST=<IP của NAS, VD: 10.0.0.10>
NAS_SHARE=<share path trên NAS, VD: Share/Public/Batch report>
NAS_USER=<service account>
NAS_PASS=<password của service account>
